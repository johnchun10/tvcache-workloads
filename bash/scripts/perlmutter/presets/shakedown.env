# Shakedown: one easy and one medium task, small and quick. It exists to show
# that every part runs (contraction, metrics, memory logging), not to learn
# anything. Any value here can be overridden on the run.sh command line.
TASKS="hello-world openssl-selfsigned-cert"
CACHE=contraction          # none | tvcache | contraction
THRESHOLD=0.9              # contraction: similarity threshold
EMBEDDER=minilm            # contraction: minilm | jina-code
BUDGET=32                  # contraction: live sandboxes all jobs share
EPOCHS=2
ROLLOUTS=4                 # rollouts per task
BATCH=1                    # tasks per training step
MAX_TOKENS=2048            # tokens per rollout
VERIFY=1                   # run tvverify on the cache afterwards
