# The evaluation run: 10 easy and 10 medium Terminal-Bench tasks. All of them
# build from one small container, need no network to solve, keep their work
# under /app, and have tests that check files rather than running services.
# Any value here can be overridden on the run.sh command line.
TASKS="hello-world analyze-access-logs jsonl-aggregator heterogeneous-dates countdown-game
       new-encrypt-command recover-obfuscated-files cpp-compatibility modernize-fortran-build git-workflow-hack
       openssl-selfsigned-cert git-leak-recovery sparql-professors-universities log-summary-date-ranges regex-log
       db-wal-recovery sqlite-db-truncate vulnerable-secret tree-directory-parser deterministic-tarball"
CACHE=contraction          # none | tvcache | contraction
THRESHOLD=0.9              # contraction: similarity threshold (the sweep: 0.8, 0.9, 0.95)
EMBEDDER=minilm            # contraction: minilm | jina-code
BUDGET=32                  # contraction: live sandboxes all jobs share
EPOCHS=5
ROLLOUTS=8                 # rollouts per task
BATCH=4                    # tasks per training step
MAX_TOKENS=2048            # tokens per rollout
VERIFY=1                   # run tvverify on the cache afterwards
